{
 "c-abduct": {
  "text": "Toes pointing forward. Lift the top leg from the hip, not the waist.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-airplane": {
  "text": "Balancing in a hinge, slowly open the pelvis to the side and close it.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-ankle": {
  "text": "Drive the knee toward the wall over your toes. Heel stays down.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-askip": {
  "text": "Tall posture, drive the knee up, quick foot strike under the hip.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-bear": {
  "text": "Knees an inch off the floor, back flat, breathing steady.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-bearreach": {
  "text": "Knees hovering, reach one arm forward without shifting your hips.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-beartap": {
  "text": "Stay in the bear position. Tap shoulders without hips moving.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-birddog": {
  "text": "Reach long, not high. Imagine a cup of water on your low back.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-birdhold": {
  "text": "Opposite arm and leg out, hold 3 seconds, hips square to the floor.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-bridge": {
  "text": "Drive through heels. Squeeze at the top, ribs down, do not arch.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-butterfly": {
  "text": "Soles together, sit tall, let the knees fall open. No bouncing.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-calfbent": {
  "text": "Same stance, now bend the back knee with the heel down. Feel it low in the calf.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-calfstraight": {
  "text": "Hands on the wall, back leg straight, heel down, lean in until you feel the calf.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-catcow": {
  "text": "Slowly round and arch your spine, moving with your breath.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-child": {
  "text": "Hips back to your heels, arms long, breathe into your low back.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-circles": {
  "text": "Draw small circles with your forearms. Hips stay still and level.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-clam": {
  "text": "Feet together, hips stacked. Open the top knee without rolling back.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-couch": {
  "text": "Back knee at the couch, shin up the front, squeeze the glute and stay tall.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-dblift": {
  "text": "Lie on your side, lift both legs together, pause, ribs down.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-deadbug": {
  "text": "Ribs down, low back flat. Lower the opposite arm and leg slowly.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-fig4": {
  "text": "Ankle across the opposite knee, pull both legs toward your chest.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-hamchair": {
  "text": "Heel on the chair, leg straight, hinge forward from the hips with a flat back.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-hamsupine": {
  "text": "On your back, hold behind the thigh and straighten the leg toward the ceiling.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-heeltap": {
  "text": "Knees stay at 90 degrees. Tap one heel down without your back arching.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-hipcircle": {
  "text": "Hand on the wall, draw big slow circles with your knee.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-hipflexor": {
  "text": "Tuck the pelvis under and shift forward until the front of the hip opens.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-hollow": {
  "text": "Low back glued to the floor. Bend knees or arms to sides if it lifts.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-hydrant": {
  "text": "Keep your spine still. Lift the knee out to the side from the hip.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-inchworm": {
  "text": "Walk your hands out to a plank and back, legs as straight as is comfortable.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-jacks": {
  "text": "Jump your feet wide and narrow, shoulders still over your hands.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-kneedrive": {
  "text": "In a side plank, drive the top knee forward without your hips dropping.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-latlunge": {
  "text": "Sit back into one hip, other leg straight, chest up.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-leglift": {
  "text": "Lift one foot a few inches and hold. Hips level and square.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-longlever": {
  "text": "Elbows ahead of your shoulders. Hold without letting hips sag.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-march": {
  "text": "Hold the bridge. Lift one foot at a time, hips level, no twisting.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-mc": {
  "text": "Hands under shoulders. Drive each knee toward chest, flat back.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-mcfast": {
  "text": "Hips low, quick feet. Stay light and rhythmic.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-ninety": {
  "text": "Both knees bent at 90 degrees, sit tall and lean gently over the front shin.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-pigeon": {
  "text": "Front shin across, back leg long, fold forward and let the hip sink.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-plank": {
  "text": "Squeeze glutes, ribs toward hips, straight line from ear to ankle.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-pogo": {
  "text": "Small quick bounces off the balls of your feet, knees soft.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-quad": {
  "text": "Hold your foot behind you, knees together, tuck the pelvis under.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-rdl": {
  "text": "Hinge on one leg, hips square, back flat, and hold your balance.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-reach": {
  "text": "Slowly reach one arm forward and hold it. Do not let hips rotate.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-reverse": {
  "text": "Hands behind you, lift your hips to a straight line, squeeze glutes.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-revlunge": {
  "text": "Step back, reach both arms up, feel the front of the hip open.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-rkc": {
  "text": "Max tension: squeeze fists, glutes and quads, pull elbows toward toes.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-rocks": {
  "text": "Hold the hollow shape and rock gently. The shape never breaks.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-saw": {
  "text": "Rock forward and back an inch. Move from the shoulders, not the hips.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-slbridge": {
  "text": "Keep hips level. Drive through the heel of the working leg.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-sldb": {
  "text": "Legs straight, lower one heel slowly. Low back never leaves the floor.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-slhold": {
  "text": "Bridge up on one leg and hold, hips level.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-slowdb": {
  "text": "4 seconds out, 4 seconds back. Do not let your ribs flare.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-sp": {
  "text": "Straight line head to heels. Hips do not sag or roll forward.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-sph": {
  "text": "Wrist under shoulder. Lift tall through the hips.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-spider": {
  "text": "Bring a knee toward the same-side elbow. Hips stay low.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-spk": {
  "text": "Stack shoulders, hips, knees. Push the floor away and lift your hips.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-splift": {
  "text": "Hold the plank, lift the top leg to hip height, hips stacked.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-spliftlow": {
  "text": "Slowly lift and lower the top leg. Pelvis does not dip.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-star": {
  "text": "On your hand, top arm and leg lifted wide. Hold everything in one plane.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-straddle": {
  "text": "Legs wide, toes up, walk your hands forward with a long spine.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-swingfb": {
  "text": "Hand on the wall, swing from the hip, trunk tall.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-swingside": {
  "text": "Face the wall, swing the leg across your body and out.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-taps": {
  "text": "Feet close. Hips stay still as a hand taps the opposite shoulder.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-trot": {
  "text": "Slowly rotate to a side plank and back. Trunk moves as one piece.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-twist": {
  "text": "Knee across your body to the floor, shoulders stay down, look the other way.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-twopoint": {
  "text": "High plank, lift the opposite arm and leg and hold. Hips square.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-wgs": {
  "text": "Lunge, elbow to instep, then rotate and reach to the ceiling.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
 "c-widetaps": {
  "text": "Feet wide for stability. Tap each shoulder without hips swaying.",
  "voice": "[{\"bm_george\": 0.6, \"bm_lewis\": 0.4}, 0.9, \"en-gb\"]"
 },
